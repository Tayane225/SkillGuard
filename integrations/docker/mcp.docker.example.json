{
  "mcpServers": {
    "skillguard": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "--tmpfs",
        "/tmp",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "-v",
        "/absolute/path/to/workspace:/workspace:ro",
        "-w",
        "/workspace",
        "skillguard:local",
        "mcp"
      ]
    }
  }
}
